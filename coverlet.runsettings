<?xml version="1.0" encoding="utf-8" ?>
<RunSettings>
  <DataCollectionRunSettings>
    <DataCollectors>
      <DataCollector friendlyName="XPlat Code Coverage">
        <Configuration>
          <!-- cobertura: gate de 80% e relatório; opencover: SonarCloud -->
          <Format>cobertura,opencover</Format>
          <Exclude>[*]Microsoft.AspNetCore.OpenApi.Generated,[OficinaOs.Infrastructure]OficinaOs.Infrastructure.Persistence.Migrations.*</Exclude>
        </Configuration>
      </DataCollector>
    </DataCollectors>
  </DataCollectionRunSettings>
</RunSettings>
